# 이 파일을 .env.local 로 복사해서 값을 채우세요. (Firebase 콘솔 > 프로젝트 설정 > 내 앱 > SDK 설정)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# 앱을 닫아도 오는 알림(푸시). 자세한 방법: docs/푸시-설정.md
# NEXT_PUBLIC_VAPID_PUBLIC_KEY, VAPID_PRIVATE_KEY 는 `node scripts/gen-vapid.mjs`로 만들어요
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:내이메일@example.com
# QSTASH_* 는 Upstash 콘솔(QStash)에서 복사해요
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
# 선택: 배포 주소(비우면 Vercel 주소를 써요)
NEXT_PUBLIC_SITE_URL=
