rules_version = '2';

// 새 편지 보안 규칙
// 원칙: 계정 없이(익명 로그인) 쓰되, 편지는 "보낸 사람"과 "도착 시각이 지난 뒤의 받는 사람"만 읽는다.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }
    function isSender(letterId) {
      return signedIn() && get(/databases/$(database)/documents/letters/$(letterId)).data.fromUid == request.auth.uid;
    }

    // 내 정보(닉네임)와 내 차단 목록: 본인만
    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
      match /blocks/{blockedUid} {
        allow read, write: if signedIn() && request.auth.uid == uid;
      }

      // 앱을 닫아도 오는 알림 주소(푸시 구독): 쓰기는 본인만, 읽기는 본인과 내 친구만.
      // 친구가 나에게 편지를 보낼 때 보낸 사람 폰이 도착 알림을 예약하는 데 써요(편지 내용은 들어 있지 않아요).
      match /push/{docId} {
        allow read: if signedIn() && docId == 'sub'
          && (request.auth.uid == uid || exists(/databases/$(database)/documents/users/$(uid)/friends/$(request.auth.uid)));
        allow create, update: if signedIn() && request.auth.uid == uid && docId == 'sub'
          && request.resource.data.keys().hasOnly(['endpoint', 'p256dh', 'auth', 'at'])
          && request.resource.data.endpoint is string && request.resource.data.endpoint.size() <= 600
          && request.resource.data.endpoint.matches('https://.*')
          && request.resource.data.p256dh is string && request.resource.data.p256dh.size() <= 200
          && request.resource.data.auth is string && request.resource.data.auth.size() <= 60;
        allow delete: if signedIn() && request.auth.uid == uid;
      }

      // 친구 목록: 읽기는 본인만. 친구 코드로 서로 연결할 때, 상대가 "나는 당신의 친구예요" 하고
      // 자기 문서(문서 ID = 자기 uid)만 내 목록에 남길 수 있고, 지우는 것도 본인 또는 그 친구만 가능
      match /friends/{friendUid} {
        allow read: if signedIn() && request.auth.uid == uid;
        allow create, update: if signedIn()
          && (request.auth.uid == uid || request.auth.uid == friendUid)
          && request.resource.data.keys().hasOnly(['uid', 'name', 'at', 'bird'])
          && request.resource.data.uid == friendUid
          && request.resource.data.name is string && request.resource.data.name.size() <= 12
          // 친구가 고른 "내 새"(얼굴 그림). 없어도 되고, 있으면 12글자 이하 글자예요
          && (!('bird' in request.resource.data) || (request.resource.data.bird is string && request.resource.data.bird.size() <= 12));
        allow delete: if signedIn() && (request.auth.uid == uid || request.auth.uid == friendUid);
      }
    }

    // 친구 코드(8글자): 코드를 아는 사람만 한 건씩 조회(목록 조회는 불가). 주인만 만들고 고치고 지움
    match /codes/{code} {
      allow get: if signedIn();
      allow create, update: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && (resource == null || resource.data.uid == request.auth.uid) // 이미 있는 코드는 주인만 고칠 수 있음
        && request.resource.data.keys().hasOnly(['uid', 'name', 'bird'])
        && request.resource.data.name is string && request.resource.data.name.size() <= 12
        && (!('bird' in request.resource.data) || (request.resource.data.bird is string && request.resource.data.bird.size() <= 12))
        && code.size() == 8;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // 편지 겉정보(누가, 어디로, 어떤 새로, 언제 도착). 편지 내용은 아래 private 문서에 따로 둔다.
    // 문서 ID가 길고 무작위라서, 링크를 받은 사람만 이 문서를 열 수 있다.
    match /letters/{letterId} {
      // 예약한 편지는 출발 시각(departAt) 전에는 보낸 사람만 열 수 있다(받는 사람에게는 출발 전까지 보이지 않아요)
      allow get: if signedIn()
        && (resource.data.fromUid == request.auth.uid || resource.data.get('departAt', request.time) <= request.time);

      // 목록은 내가 보낸 편지, 또는 내가 받는 사람으로 등록된 편지만
      allow list: if signedIn() &&
        (resource.data.fromUid == request.auth.uid || resource.data.recipientUid == request.auth.uid);

      allow create: if signedIn()
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.sentAt == request.time
        && request.resource.data.arriveAt > request.time
        && request.resource.data.keys().hasOnly(['fromUid', 'fromName', 'toName', 'routeId', 'birdId', 'sentAt', 'arriveAt', 'recipientUid', 'departAt', 'replyTo'])
        // 예약 발송: 출발 시각은 지금부터 최대 366일 뒤까지, 도착은 항상 출발보다 뒤(core/schedule.ts의 MAX_SCHEDULE_DAYS와 같아야 해요)
        && (!('departAt' in request.resource.data)
            || (request.resource.data.departAt is timestamp
                && request.resource.data.departAt >= request.time
                && request.resource.data.departAt <= request.time + duration.value(366, 'd')))
        && request.resource.data.arriveAt > request.resource.data.get('departAt', request.time)
        // 받는 사람은 비워 두거나(링크로 전달), 서로 친구인 사람의 uid(앱 안에서 바로 전달),
        // 또는 "답장": 내가 받은 편지(replyTo)의 보낸 사람에게만 보낼 수 있다(친구가 아니어도 됨)
        && (request.resource.data.recipientUid == null
            || (request.resource.data.recipientUid is string
                && exists(/databases/$(database)/documents/users/$(request.resource.data.recipientUid)/friends/$(request.auth.uid)))
            || (request.resource.data.replyTo is string
                && get(/databases/$(database)/documents/letters/$(request.resource.data.replyTo)).data.recipientUid == request.auth.uid
                && get(/databases/$(database)/documents/letters/$(request.resource.data.replyTo)).data.fromUid == request.resource.data.recipientUid))
        && request.resource.data.toName is string && request.resource.data.toName.size() <= 20
        && request.resource.data.fromName is string && request.resource.data.fromName.size() <= 12;

      // 링크를 연 사람이 "받는 사람"으로 한 번만 등록할 수 있다(보낸 사람 본인은 불가)
      allow update: if signedIn()
        && resource.data.fromUid != request.auth.uid
        && resource.data.recipientUid == null
        && request.resource.data.recipientUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['recipientUid']);

      // 보낸 사람은 자기 편지를 지울 수 있다(탈퇴 시 삭제에도 사용)
      allow delete: if signedIn() && resource.data.fromUid == request.auth.uid;

      // 편지 내용: 보낸 사람은 언제나, 그 밖의 사람은 도착 시각이 지난 뒤에만 읽는다
      match /private/{docId} {
        allow read: if signedIn() && (
          isSender(letterId) ||
          get(/databases/$(database)/documents/letters/$(letterId)).data.arriveAt <= request.time
        );
        // 편지 글(body)과 사진(photo0~photo2, 줄여서 글자로 바꾼 것 한 장씩)을 따로 저장해서 문서 하나가 1MB를 넘지 않게 한다
        allow create: if signedIn()
          && getAfter(/databases/$(database)/documents/letters/$(letterId)).data.fromUid == request.auth.uid
          && (
            (docId == 'body'
              && request.resource.data.keys().hasOnly(['message'])
              && request.resource.data.message is string
              && request.resource.data.message.size() > 0 && request.resource.data.message.size() <= 100000) // core/limits.ts의 MAX_LETTER_CHARS와 같아야 해요
            || (docId.matches('photo[0-2]')
              && request.resource.data.keys().hasOnly(['data'])
              && request.resource.data.data is string
              && request.resource.data.data.size() > 0 && request.resource.data.data.size() <= 450000)); // core/limits.ts의 MAX_PHOTO_CHARS와 같아야 해요
        allow delete: if isSender(letterId);
      }
    }

    // 신고: 쓰기만 가능(읽기는 운영자가 콘솔에서)
    match /reports/{reportId} {
      allow create: if signedIn()
        && request.resource.data.reporterUid == request.auth.uid
        && request.resource.data.keys().hasOnly(['reporterUid', 'letterId', 'reason', 'createdAt'])
        && request.resource.data.createdAt == request.time;
      allow read, update, delete: if false;
    }
  }
}
